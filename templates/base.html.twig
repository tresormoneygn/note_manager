<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Gestion Scolaire - CI{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>CI</text></svg>">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}

    <style>
        /* Masquer les barres de défilement */
        *::-webkit-scrollbar {
            width: 0.25rem;
            height: 0.25rem;
        }

        *::-webkit-scrollbar-thumb {
            background-color: #6366f1;
            border-radius: 0.5rem;
        }

        dialog::backdrop {
            background-color: rgba(0, 0, 0, 0.5);
        }

        .transition-smooth {
            transition: all 0.3s ease;
        }
    </style>
</head>
<body class="bg-gray-50 font-sans antialiased">
<!-- Structure principale -->
<div class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <div id="sidebar-container" class="absolute inset-y-0 left-0 transform -translate-x-full md:relative md:translate-x-0 transition-smooth z-30 md:z-0">
        <aside class="w-64 h-full bg-white shadow-lg flex flex-col">
            <!-- Sidebar Header -->
            <div class="flex items-center justify-between px-4 py-5 border-b border-gray-200">
                <div class="flex items-center space-x-3">
                    <img src="{{ asset('/logo.jpg') }}" alt="Logo CI" class="h-10 w-10"/>
                    <span class="text-xl font-semibold text-indigo-600">CI</span>
                </div>
            </div>

            <!-- Sidebar Content -->
            <div class="flex-grow px-3 py-4 overflow-y-auto">
                <ul class="space-y-2 font-medium">
                    <!-- Dashboard -->
                    <li>
                        <a href="{{ path('app_index') }}" class="flex items-center p-3 rounded-lg hover:bg-indigo-50 group transition-smooth {% if app.request.get('_route') == 'app_dashboard' %}bg-indigo-100 text-indigo-700{% endif %}">
                            <i class="fas fa-home text-gray-500 group-hover:text-indigo-600 w-5 mr-3 text-center"></i>
                            <span>Tableau de bord</span>
                        </a>
                    </li>

                    <!-- Étudiants -->
                    <li>
                        <a href="{{ path('app_etudiant_index') }}" class="flex items-center p-3 rounded-lg hover:bg-indigo-50 group transition-smooth {% if 'etudiant' in app.request.get('_route') %}bg-indigo-100 text-indigo-700{% endif %}">
                            <i class="fas fa-users text-gray-500 group-hover:text-indigo-600 w-5 mr-3 text-center"></i>
                            <span>Étudiants</span>
                        </a>
                    </li>

                    <!-- Inscriptions -->
                    <li>
                        <a href="{{ path('app_inscription_index') }}" class="flex items-center p-3 rounded-lg hover:bg-indigo-50 group transition-smooth {% if 'inscription' in app.request.get('_route') %}bg-indigo-100 text-indigo-700{% endif %}">
                            <i class="fas fa-user-edit text-gray-500 group-hover:text-indigo-600 w-5 mr-3 text-center"></i>
                            <span>Inscriptions</span>
                        </a>
                    </li>

                    <!-- Notes -->
                    <li>
                        <a href="{{ path('app_note_index') }}" class="flex items-center p-3 rounded-lg hover:bg-indigo-50 group transition-smooth {% if 'note' in app.request.get('_route') %}bg-indigo-100 text-indigo-700{% endif %}">
                            <i class="fas fa-file-alt text-gray-500 group-hover:text-indigo-600 w-5 mr-3 text-center"></i>
                            <span>Notes</span>
                        </a>
                    </li>

                    <!-- Matières -->
                    <li>
                        <a href="{{ path('app_matiere_index') }}" class="flex items-center p-3 rounded-lg hover:bg-indigo-50 group transition-smooth {% if 'matiere' in app.request.get('_route') %}bg-indigo-100 text-indigo-700{% endif %}">
                            <i class="fas fa-book text-gray-500 group-hover:text-indigo-600 w-5 mr-3 text-center"></i>
                            <span>Matières</span>
                        </a>
                    </li>

                    <!-- UE -->
                    <li>
                        <a href="{{ path('app_unite_enseignement_index') }}" class="flex items-center p-3 rounded-lg hover:bg-indigo-50 group transition-smooth {% if 'unite_enseignement' in app.request.get('_route') %}bg-indigo-100 text-indigo-700{% endif %}">
                            <i class="fas fa-layer-group text-gray-500 group-hover:text-indigo-600 w-5 mr-3 text-center"></i>
                            <span>Unités d'enseignement</span>
                        </a>
                    </li>

                    <!-- Départements -->
                    <li>
                        <a href="{{ path('app_departement_historique_index') }}" class="flex items-center p-3 rounded-lg hover:bg-indigo-50 group transition-smooth {% if 'departement' in app.request.get('_route') %}bg-indigo-100 text-indigo-700{% endif %}">
                            <i class="fas fa-building text-gray-500 group-hover:text-indigo-600 w-5 mr-3 text-center"></i>
                            <span>Départements</span>
                        </a>
                    </li>

                    <!-- Programme -->
                    <li>
                        <a href="{{ path('app_programme_index') }}" class="flex items-center p-3 rounded-lg hover:bg-indigo-50 group transition-smooth {% if 'programme' in app.request.get('_route') %}bg-indigo-100 text-indigo-700{% endif %}">
                            <i class="fas fa-graduation-cap text-gray-500 group-hover:text-indigo-600 w-5 mr-3 text-center"></i>
                            <span>Programmes</span>
                        </a>
                    </li>

                    <!-- Séparateur -->
                    <div class="my-4 border-t border-gray-200"></div>

                    <!-- Administration -->
                    <li>
                        <a href="{{ path('app_user_index') }}" class="flex items-center p-3 rounded-lg hover:bg-indigo-50 group transition-smooth {% if 'user' in app.request.get('_route') %}bg-indigo-100 text-indigo-700{% endif %}">
                            <i class="fas fa-user-shield text-gray-500 group-hover:text-indigo-600 w-5 mr-3 text-center"></i>
                            <span>Utilisateurs</span>
                        </a>
                    </li>

                    <!-- Profil -->
                    <li>
                        <a href="{{ path('app_user_index') }}" class="flex items-center p-3 rounded-lg hover:bg-indigo-50 group transition-smooth {% if 'profile' in app.request.get('_route') %}bg-indigo-100 text-indigo-700{% endif %}">
                            <i class="fas fa-user-cog text-gray-500 group-hover:text-indigo-600 w-5 mr-3 text-center"></i>
                            <span>Profil</span>
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Déconnexion -->
            <div class="p-4 border-t border-gray-200">
                <a href="{{ path('app_logout') }}" class="flex items-center p-3 text-white rounded-lg bg-red-600 hover:bg-red-700 transition-smooth">
                    <i class="fas fa-sign-out-alt w-5 mr-3 text-center"></i>
                    <span>Déconnexion</span>
                </a>
            </div>
        </aside>
    </div>

    <!-- Contenu principal -->
    <div class="flex-1 flex flex-col overflow-hidden">
        <!-- Header -->
        <header class="bg-white shadow-sm z-10">
            <div class="flex items-center justify-between px-6 py-4">
                <!-- Menu hamburger -->
                <button id="sidebar-toggle" class="md:hidden text-gray-600 hover:text-indigo-600 focus:outline-none">
                    <i class="fas fa-bars text-xl"></i>
                </button>

                <!-- Titre de la page -->
                <h1 class="text-xl font-semibold text-gray-800">
                    {% block page_title %}{% endblock %}
                </h1>

                <!-- User menu -->
                <div class="flex items-center space-x-4">
                    <div class="relative">
                        <button id="user-menu-button" class="flex items-center space-x-2 focus:outline-none">
{#                            <span class="text-gray-700">{{ app.user.username }}</span>#}
                            <i class="fas fa-chevron-down text-xs text-gray-500"></i>
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <!-- Contenu -->
        <main class="flex-1 overflow-auto p-6 bg-gray-50">
            {% for message in app.flashes('success') %}
                <div class="mb-6 p-4 bg-green-100 border-l-4 border-green-500 text-green-700">
                    <div class="flex items-center">
                        <i class="fas fa-check-circle mr-2"></i>
                        <p>{{ message }}</p>
                    </div>
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="mb-6 p-4 bg-red-100 border-l-4 border-red-500 text-red-700">
                    <div class="flex items-center">
                        <i class="fas fa-exclamation-circle mr-2"></i>
                        <p>{{ message }}</p>
                    </div>
                </div>
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    </div>
</div>

<!-- Overlay pour mobile -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-gray-900 bg-opacity-50 z-20 hidden"></div>

<!-- Scripts -->
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Gestion du sidebar
        const sidebarContainer = document.getElementById('sidebar-container');
        const sidebarBackdrop = document.getElementById('sidebar-backdrop');
        const sidebarToggle = document.getElementById('sidebar-toggle');

        sidebarToggle.addEventListener('click', function() {
            sidebarContainer.classList.toggle('-translate-x-full');
            sidebarBackdrop.classList.toggle('hidden');
        });

        sidebarBackdrop.addEventListener('click', function() {
            sidebarContainer.classList.add('-translate-x-full');
            sidebarBackdrop.classList.add('hidden');
        });

        // Fermer le sidebar lors du clic sur un lien (mobile)
        document.querySelectorAll('#sidebar-container a').forEach(link => {
            link.addEventListener('click', function() {
                if (window.innerWidth < 768) {
                    sidebarContainer.classList.add('-translate-x-full');
                    sidebarBackdrop.classList.add('hidden');
                }
            });
        });
    });
</script>
</body>
</html>