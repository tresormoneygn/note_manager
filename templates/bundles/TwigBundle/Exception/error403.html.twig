{% extends 'base.html.twig' %}

{% block title %}Accès Refusé{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <h1 class="display-4 text-danger mb-4">403 - Accès Refusé</h1>
            <div class="alert alert-danger">
                <p class="lead">{{ message ?? 'Vous n\'avez pas les permissions nécessaires pour accéder à cette page.' }}</p>
            </div>
            <a href="{{ path('app_home') }}" class="btn btn-primary mt-3">
                <i class="fas fa-home me-2"></i>Retour à l'accueil
            </a>
        </div>
    </div>
</div>
{% endblock %}