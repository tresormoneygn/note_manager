{% extends 'base.html.twig' %}

{% block title %}Départements{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold mb-8 text-gray-800">Liste des Départements</h1>

    <div class="overflow-x-auto shadow rounded-lg">
        <table class="min-w-full bg-white border border-gray-200">
            <thead class="bg-gray-100">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">ID</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Nom</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Label</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
            {% for departement in departements %}
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">{{ departement.id }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ departement.name }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ departement.label }}</td>
                    <td class="px-6 py-4 whitespace-nowrap space-x-2">
                        <a href="{{ path('app_departement_show', {'id': departement.id}) }}" class="text-indigo-600 hover:text-indigo-900 font-medium">Voir</a>
                        <a href="{{ path('app_departement_edit', {'id': departement.id}) }}" class="text-yellow-600 hover:text-yellow-900 font-medium">Modifier</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-gray-500">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-6">
        <a href="{{ path('app_departement_new') }}" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            Créer un nouveau département
        </a>
    </div>
{% endblock %}
