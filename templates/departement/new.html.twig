{% extends 'base.html.twig' %}

{% block title %}New Departement{% endblock %}

{% block body %}
    <h1>Create new Departement</h1>
     {# Affichage des messages flashs #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {{ include('departement/_form.html.twig') }}

    <a href="{{ path('app_departement_index') }}">back to list</a>
{% endblock %}
