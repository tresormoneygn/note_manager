{% extends 'base.html.twig' %}

{% block title %}Historique des Départements{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold mb-8 text-gray-800">Historique des Départements</h1>

    <div class="overflow-x-auto shadow rounded-lg">
        <table class="min-w-full bg-white border border-gray-200">
            <thead class="bg-gray-100">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">ID</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Nom du Département</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Année</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Créé le</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Mis à jour le</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
            {% for departement_historique in departement_historiques %}
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">{{ departement_historique.id }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ departement_historique.departement.name }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ departement_historique.annee.name }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {{ departement_historique.createdAt ? departement_historique.createdAt|date('Y-m-d H:i:s') : 'N/A' }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        {{ departement_historique.updatedAt ? departement_historique.updatedAt|date('Y-m-d H:i:s') : 'N/A' }}
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex space-x-3">
                            <!-- Icône œil pour Voir -->
                            <a href="{{ path('app_departement_historique_show', {'id': departement_historique.id}) }}"
                               class="text-blue-600 hover:text-blue-800 transition-colors duration-200"
                               title="Voir détails">
                                <i class="fas fa-eye"></i>
                            </a>

                            <!-- Icône crayon pour Modifier -->
                            <a href="{{ path('app_departement_historique_edit', {'id': departement_historique.id}) }}"
                               class="text-yellow-500 hover:text-yellow-700 transition-colors duration-200"
                               title="Modifier">
                                <i class="fas fa-pencil-alt"></i>
                            </a>

                            <!-- (Optionnel) Icône poubelle pour Supprimer -->
                            <form method="post"
                                  action="{{ path('app_departement_historique_delete', {'id': departement_historique.id}) }}"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet historique ?');"
                                  class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ departement_historique.id) }}">
                                <button type="submit"
                                        class="text-red-500 hover:text-red-700 transition-colors duration-200"
                                        title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="px-6 py-4 text-center text-gray-500">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-6">
        <a href="{{ path('app_departement_historique_new') }}" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            Créer un nouvel historique
        </a>
    </div>
{% endblock %}
