<!doctype html>
<html lang="en">
{{ include('partials/header.html.twig') }}
<body>
    <main class="container mx-auto px-4 py-8 max-w-7xl">
        <div class="mb-10">
            <div class="bg-blue-100 text-blue-800 px-4 py-2 rounded-full inline-block mb-6">
                Note Manager • Administration
            </div>

            <div class="flex justify-between items-start">
                <div class="max-w-xl">
                    <h1 class="text-5xl font-bold text-gray-900 mb-4">Tableau de bord <span class="block text-blue-600">NoteManager</span></h1>

                    <p class="text-gray-700 mb-8 text-lg">
                        Accédez à tous vos outils d'administration notemanager, suivez vos performances et prenez des décisions éclairées grâce à notre interface intuitive.
                    </p>

                    <div class="flex gap-4">
                        {% if not app.user %}
                            <a href="{{ path('app_login') }}" class="bg-blue-600 text-white px-6 py-3 rounded-lg flex items-center gap-2 hover:bg-blue-700 transition duration-300">
                                Se connecter
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                            </a>
                        {% else %}
                            <a href="{{ path('app_home') }}" class="bg-blue-600 text-white px-6 py-3 rounded-lg flex items-center gap-2 hover:bg-blue-700 transition duration-300">
                                Tableau de bord
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                            </a>
                        {% endif %}
                    </div>
                </div>

                <div class="hidden md:block">
                    <div class="bg-white rounded-lg shadow-lg p-2 w-96 border border-blue-100">
                        <img src="/logo.jpg" alt="Dashboard Preview" class="rounded w-full h-full" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Features Grid -->
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-20">
            <!-- Feature 1: Statistiques en temps réel -->
            <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-lg transition duration-300 border-t-4 border-blue-500">
                <div class="bg-blue-100 rounded-full w-12 h-12 flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1e40af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"></path><path d="M18 20V4"></path><path d="M6 20v-6"></path></svg>
                </div>
                <h3 class="text-xl font-bold mb-3">Statistiques en temps réel</h3>
                <p class="text-gray-600">
                    Suivez les performances de votre entreprise avec des tableaux de bord interactifs.
                </p>
            </div>

            <!-- Feature 2: Gestion des utilisateurs -->
            <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-lg transition duration-300 border-t-4 border-blue-500">
                <div class="bg-blue-100 rounded-full w-12 h-12 flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1e40af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <h3 class="text-xl font-bold mb-3">Gestion des utilisateurs</h3>
                <p class="text-gray-600">
                    Gérez facilement les comptes clients et les permissions d'accès.
                </p>
            </div>

            <!-- Feature 3: Configuration avancée -->
            <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-lg transition duration-300 border-t-4 border-blue-500">
                <div class="bg-blue-100 rounded-full w-12 h-12 flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1e40af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                </div>
                <h3 class="text-xl font-bold mb-3">Configuration avancée</h3>
                <p class="text-gray-600">
                    Personnalisez tous les aspects de votre plateforme selon vos besoins.
                </p>
            </div>

            <!-- Feature 4: Sécurité renforcée -->
            <div class="bg-white rounded-2xl shadow-md p-8 hover:shadow-lg transition duration-300 border-t-4 border-blue-500">
                <div class="bg-blue-100 rounded-full w-12 h-12 flex items-center justify-center mb-6">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1e40af" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"></path></svg>
                </div>
                <h3 class="text-xl font-bold mb-3">Sécurité renforcée</h3>
                <p class="text-gray-600">
                    Protection des données et conformité aux normes de sécurité les plus strictes.
                </p>
            </div>
        </section>
    </main>
</body>
</html>