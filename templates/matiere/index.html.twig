{% extends 'base.html.twig' %}

{% block title %}NoteManager - Création Matiere{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold mb-8 text-gray-800">Liste des Matières</h1>

    <div class="overflow-x-auto shadow rounded-lg">
        <table class="min-w-full bg-white border border-gray-200">
            <thead class="bg-gray-100">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">ID</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Nom</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Professeur</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Programme</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Coefficient</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
            {% for matiere in matieres %}
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">{{ matiere.id }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ matiere.name }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ matiere.user.email }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ matiere.uniteEnseignement.programme.name }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ matiere.coefficient }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center space-x-4">
                            <!-- Bouton Voir -->
                            <a href="{{ path('app_matiere_show', {'id': matiere.id}) }}"
                               class="text-indigo-600 hover:text-indigo-900 transition-colors duration-200"
                               title="Voir détails">
                                <i class="fas fa-eye mr-1"></i>
                            </a>

                            <!-- Bouton Modifier -->
                            <a href="{{ path('app_matiere_edit', {'id': matiere.id}) }}"
                               class="text-yellow-600 hover:text-yellow-900 transition-colors duration-200"
                               title="Modifier">
                                <i class="fas fa-edit mr-1"></i>
                            </a>

                            <!-- Bouton Supprimer (optionnel) -->
                            <form action="{{ path('app_matiere_delete', {'id': matiere.id}) }}"
                                  method="POST"
                                  class="inline"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette matière ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ matiere.id) }}">
                                <button type="submit"
                                        class="text-red-600 hover:text-red-900 transition-colors duration-200"
                                        title="Supprimer">
                                    <i class="fas fa-trash-alt mr-1"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-gray-500">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-6">
        <a href="{{ path('app_matiere_new') }}" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            Créer une nouvelle matière
        </a>
    </div>
{% endblock %}
