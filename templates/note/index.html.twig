{% extends 'base.html.twig' %}

{% block title %}Note index{% endblock %}

{% block body %}
    <h1>Note index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Note_1</th>
                <th>Note_2</th>
                <th>Note_3</th>
                <th>Created_at</th>
                <th>Updated_at</th>
                <th>Max_delay</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for note in notes %}
            <tr>
                <td>{{ note.id }}</td>
                <td>{{ note.note1 }}</td>
                <td>{{ note.note2 }}</td>
                <td>{{ note.note3 }}</td>
                <td>{{ note.createdAt ? note.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ note.updatedAt ? note.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ note.maxDelay ? note.maxDelay|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_note_show', {'id': note.id}) }}">show</a>
                    <a href="{{ path('app_note_edit', {'id': note.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="8">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_note_new') }}">Create new</a>
{% endblock %}
