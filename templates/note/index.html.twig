{% extends 'base.html.twig' %}

{% block title %}Gestion des Notes{% endblock %}

{% block page_title %}Gestion des Notes{% endblock %}

{% block body %}
    <div class="container mx-auto px-4 py-6">
        {{ include('partials/flush.html.twig') }}
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-2xl font-bold text-gray-800">Liste des Notes</h1>

            <div class="flex gap-2">
                <button class="btn btn-secondary bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md flex items-center" onclick="document.getElementById('uploadModal').classList.remove('hidden')">
                    <i class="fas fa-upload mr-2"></i> Importer les notes
                </button>

                <a href="{{ path('app_note_new') }}" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-md flex items-center">
                    <i class="fas fa-plus-circle mr-2"></i> Nouvelle Note
                </a>
            </div>

            <!-- Modal Upload (initialement caché) -->
            <div id="uploadModal" class="fixed inset-0 bg-gray-800 bg-opacity-50 items-center flex justify-center z-50 hidden">
                <div class="bg-white rounded-lg shadow-lg w-full max-w-md">
                    <form method="POST" action="{{ path('app_note_import') }}" enctype="multipart/form-data">
                        <div class="px-6 py-4 border-b border-gray-200 flex justify-between items-center">
                            <h3 class="text-lg font-semibold">Importer les notes</h3>
                            <button type="button" onclick="document.getElementById('uploadModal').classList.add('hidden')" class="text-gray-500 hover:text-gray-700 text-xl">&times;</button>
                        </div>

                        <!-- AVERTISSEMENT -->
                        <div class="px-6 pt-4 pb-0">
                            <div class="bg-yellow-100 text-yellow-800 text-sm p-3 rounded border border-yellow-300">
                                ⚠️ Cette opération <strong>écrasera les anciennes notes</strong> des étudiants pour la matière sélectionnée.
                                Veuillez vérifier votre fichier avant de continuer.
                            </div>
                        </div>

                        <div class="p-6">
                            <label for="matiere_select" class="block mb-2 text-sm font-medium text-gray-700">Sélectionner une matière</label>
                            <select name="matiere_id" id="matiere_select" required class="w-full text-sm text-gray-700 border border-gray-300 rounded p-2">
                                <option value="" disabled selected>-- Choisir une matière --</option>
                                {% for matiere in matieres %}
                                    <option value="{{ matiere.id }}">{{ matiere.name }}</option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="p-6">
                            <label class="block mb-2 text-sm font-medium text-gray-700">Fichier Excel (.xlsx)</label>
                            <input type="file" name="excel_file" accept=".xlsx" required class="w-full text-sm text-gray-700 border border-gray-300 rounded p-2">
                        </div>

                        <div class="px-6 py-4 border-t border-gray-200 flex justify-end">
                            <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded hover:bg-green-700">Importer</button>
                        </div>
                    </form>
                </div>
            </div>



            <!-- Modal Tailwind -->
            {# <div id="uploadModal" class="fixed inset-0 flex items-center justify-center z-50 hidden">
            <div class="bg-gray-900 bg-opacity-50 absolute inset-0"></div>
            <div class="bg-white rounded-lg shadow-lg w-96">
                <div class="flex justify-between items-center p-4 border-b">
                <h5 class="text-lg font-semibold">Importer un fichier Excel</h5>
                <button type="button" class="text-gray-500 hover:text-gray-800" id="closeModal" aria-label="Fermer">
                    &times;
                </button>
                </div>
                <div class="p-4">
                {{ form_start(form, {'attr': {'enctype': 'multipart/form-data'}}) }}
                    <div class="mb-4">
                    {{ form_row(form.fichier) }}
                    </div>
                    <button type="submit" class="w-full py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 focus:outline-none">Importer</button>
                {{ form_end(form) }}
                </div>
            </div>
            </div> #}

        </div>
        <div>
            <h2 class="text-xl font-semibold mb-4">Filtrer les Notes</h2>
                <div class="flex items gap-3">
                    {{ form_start(form, {'method': 'get'}) }}
                            <div class="flex gap-2 mb-2">
                                <div class='py-2'>
                                    {{ form_label(form.matricule) }}
                                    {{ form_widget(form.matricule, {'attr': {'class': 'border border-black rounded-md'}}) }}
                                </div>
                                <div class='py-2'>
                                    {{ form_label(form.nom) }}
                                    {{ form_widget(form.nom, {'attr': {'class': 'border border-black rounded-md'}}) }}
                                </div>
                                <div class='py-2'>
                                    {{ form_label(form.annee) }}
                                    {{ form_widget(form.annee, {'attr': {'class': 'border border-black rounded-md'}}) }}
                                </div>
                                <div class='py-2'>
                                    {{ form_label(form.matiere) }}
                                    {{ form_widget(form.matiere, {'attr': {'class': 'border border-black rounded-md'}}) }}
                                </div>
                                <div class="btn btn-secondary bg-red-500 text-white px-3 py-2 rounded-md">
                                    {{ form_widget(form.filtrer) }}
                                </div>
                                {# Bouton de réinitialisation en tant que lien #}
                                <a href="{{ path('app_note_index') }}" class="btn btn-secondary bg-red-500 text-white px-3 py-2 rounded-md">
                                    Réinitialiser
                                </a>
                            </div>
                    {{ form_end(form) }}

                        {% if etudiants is defined %}
                            <h2>Résultats</h2>
                            <ul>
                                {% for etudiant in etudiants %}
                                    <li>{{ etudiant.matricule }} - {{ etudiant.nom }} - {{ etudiant.annee }}</li>
                                {% else %}
                                    <li>Aucun résultat trouvé.</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                </div>
        </div>

        <div class="bg-white shadow-md rounded-lg overflow-hidden">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Note 1</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Note 2</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Note 3</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Créé le</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Modifié le</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Délai max</th>
                        <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                    {% for note in notes %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">{{ note.id }}</td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium {% if note.note1 < 10 %}text-red-600{% else %}text-green-600{% endif %}">
                                {{ note.note1|number_format(2) }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium {% if note.note2 < 10 %}text-red-600{% else %}text-green-600{% endif %}">
                                {{ note.note2|number_format(2) }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium {% if note.note3 < 10 %}text-red-600{% else %}text-green-600{% endif %}">
                                {{ note.note3|number_format(2) }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {{ note.createdAt ? note.createdAt|date('d/m/Y H:i') : '' }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {{ note.updatedAt ? note.updatedAt|date('d/m/Y H:i') : '' }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                                {{ note.maxDelay ? note.maxDelay|date('d/m/Y') : '' }}
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex space-x-2">
                                    <a href="{{ path('app_note_show', {'id': note.id}) }}" class="text-indigo-600 hover:text-indigo-900" title="Voir">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <span class="text-gray-300">|</span>
                                    <a href="{{ path('app_note_edit', {'id': note.id}) }}" class="text-green-600 hover:text-green-900" title="Modifier">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="px-6 py-4 text-center text-sm text-gray-500">
                                <i class="fas fa-info-circle mr-2"></i>Aucune note trouvée
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>


        {# Statitique des notes #}
        <div class="bg-white shadow-md rounded-lg overflow-hidden mt-5 p-4">
            {# Diagramme #}
            <h2 class="text-xl font-semibold mb-4 mt-4">Statistiques des Notes</h2>
            <p class="text-gray-600 mb-4">Répartition des notes par valeur</p>
            <canvas id="noteChart" width="300" height="300"></canvas>
            <script>
                var ctx = document.getElementById('noteChart').getContext('2d');

                var noteChart = new Chart(ctx, {
                    type: 'pie', // Ou 'doughnut' pour un diagramme en donut
                    data: {
                        labels: ['A', 'B', 'C'], // Les labels des catégories
                        datasets: [{
                            label: 'Répartition des notes',
                            data: [300, 150, 100], // Les données des catégories
                            backgroundColor: ['#ff9999', '#66b3ff', '#99ff99'],
                            borderColor: ['#fff', '#fff', '#fff', '#fff', '#fff'],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: false,
                        plugins: {
                            legend: {
                                position: 'top',
                            },
                            tooltip: {
                                callbacks: {
                                    label: function(tooltipItem) {
                                        return tooltipItem.label + ': ' + tooltipItem.raw + ' notes';
                                    }
                                }
                            }
                        }
                    }
                });
            </script>
        </div>
    </div>
{% endblock %}