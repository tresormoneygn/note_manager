{% extends 'base.html.twig' %}

{% block title %}Programme index{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold mb-6 text-center text-gray-800">Programme index</h1>

    <div class="overflow-x-auto">
        <table class="min-w-full bg-white rounded-lg shadow-md">
            <thead class="bg-gray-100">
            <tr>
                <th class="py-3 px-6 text-left text-sm font-semibold text-gray-700">Id</th>
                <th class="py-3 px-6 text-left text-sm font-semibold text-gray-700">Name</th>
                <th class="py-3 px-6 text-left text-sm font-semibold text-gray-700">Created_at</th>
                <th class="py-3 px-6 text-left text-sm font-semibold text-gray-700">Updated_at</th>
                <th class="py-3 px-6 text-left text-sm font-semibold text-gray-700">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
            {% for programme in programmes %}
                <tr class="hover:bg-gray-50">
                    <td class="py-4 px-6">{{ programme.id }}</td>
                    <td class="py-4 px-6">{{ programme.name }}</td>
                    <td class="py-4 px-6">{{ programme.createdAt ? programme.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td class="py-4 px-6">{{ programme.updatedAt ? programme.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                    <td class="py-4 px-6 flex space-x-2">
                        <a href="{{ path('app_programme_show', {'id': programme.id}) }}" class="text-blue-600 hover:underline">Show</a>
                        <a href="{{ path('app_programme_edit', {'id': programme.id}) }}" class="text-yellow-500 hover:underline">Edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="py-4 px-6 text-center text-gray-500">No records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-6 text-center">
        <a href="{{ path('app_programme_new') }}" class="inline-block bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded">
            Create new
        </a>
    </div>
{% endblock %}
