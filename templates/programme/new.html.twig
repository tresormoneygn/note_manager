{% extends 'base.html.twig' %}

{% block title %}New Programme{% endblock %}

{% block body %}
    <h1>Create new Programme</h1>
    {# Affichage des messages flashs #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    {{ include('programme/_form.html.twig') }}

    <a href="{{ path('app_programme_index') }}">back to list</a>
{% endblock %}
