{% extends 'base.html.twig' %}

{% block title %}Note Manager - Inscription{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
{% endblock %}

{% block body %}
    <div class="py-5">
        <div class="flex justify-center">
            <div class="w-full">
                {% for flash_error in app.flashes('verify_email_error') %}
                    <div class="bg-red-500 text-white p-4 rounded mb-4" role="alert">
                        <i class="fas fa-exclamation-triangle mr-2"></i>{{ flash_error }}
                    </div>
                {% endfor %}

                <div class="bg-white shadow-lg rounded-lg">
                    <div class="bg-blue-600 text-white text-center rounded-t-lg p-6">
                        <h3 class="text-lg font-semibold"><i class="fas fa-user-plus mr-2"></i>Créer un compte</h3>
                    </div>
                    <div class="p-6">
                        {{ form_errors(registrationForm) }}

                        {{ form_start(registrationForm) }}

                        <div class="mb-4">
                            <h5 class="mb-3 text-lg font-medium">Fonction(s)</h5>
                            <p class="text-gray-500 text-sm">Veuillez sélectionner une ou plusieurs fonctions</p>
                            {{ form_row(registrationForm.fonctions, {
                                'attr': {'class': 'm-2'},
                                'row_attr': {'class': 'm-6'},
                                'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'},
                                'help_attr': {'class': 'text-sm text-gray-500 mt-1'}
                            }) }}
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="mb-3">
                                {{ form_row(registrationForm.first_name) }}
                            </div>
                            <div class="mb-3">
                                {{ form_row(registrationForm.last_name) }}
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="mb-3">
                                {{ form_row(registrationForm.email) }}
                            </div>
                            <div class="mb-3">
                                {{ form_row(registrationForm.date_naissance) }}
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="mb-3">
                                {{ form_row(registrationForm.numero) }}
                            </div>
                            <div class="mb-3">
                                {{ form_row(registrationForm.matricule) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_row(registrationForm.addresse) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(registrationForm.plainPassword) }}
                        </div>

                        <div class="mb-4">
                            {{ form_row(registrationForm.agreeTerms) }}
                        </div>

                        <div class="mb-4">
                            <button type="submit" class="w-full bg-blue-600 text-white py-3 rounded-lg hover:bg-blue-700 transition">
                                <i class="fas fa-user-plus mr-2"></i>S'inscrire
                            </button>
                        </div>

                        {{ form_end(registrationForm) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        // Script pour mettre en évidence le type d'utilisateur sélectionné
        document.addEventListener('DOMContentLoaded', function() {
            const userTypeInputs = document.querySelectorAll('input[name="registration_form[userType]"]');

            userTypeInputs.forEach(input => {
                input.addEventListener('change', function() {
                    // Mettre en évidence le type d'utilisateur sélectionné
                    const parentLabel = this.closest('.form-check');
                    document.querySelectorAll('.form-check').forEach(el => {
                        el.classList.remove('selected-type');
                    });
                    if (parentLabel) {
                        parentLabel.classList.add('selected-type');
                    }
                });
            });
        });
    </script>
{% endblock %}