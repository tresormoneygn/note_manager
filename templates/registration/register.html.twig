{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        .card {
            border: none;
            border-radius: 10px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
        }
        .card-header {
            background-color: #4e73df;
            color: white;
            border-radius: 10px 10px 0 0 !important;
            padding: 1.5rem;
        }
        .form-control, .form-select {
            border-radius: 5px;
            padding: 10px 15px;
            border: 1px solid #d1d3e2;
        }
        .btn-primary {
            background-color: #4e73df;
            border-color: #4e73df;
            padding: 10px 25px;
            border-radius: 5px;
        }
        .btn-primary:hover {
            background-color: #2e59d9;
            border-color: #2653d4;
        }
        .user-type-selector {
            margin-bottom: 1.5rem;
        }
        .user-type-selector .form-check {
            padding: 10px 15px;
            border: 1px solid #d1d3e2;
            border-radius: 5px;
            margin-bottom: 10px;
            transition: all 0.2s;
        }
        .user-type-selector .form-check:hover {
            background-color: #f8f9fc;
        }
        .user-type-selector .form-check-input:checked + .form-check-label {
            font-weight: bold;
        }
        .form-check-input:checked ~ .form-check {
            border-color: #4e73df;
            background-color: #eef2ff;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="alert alert-danger" role="alert">
                    <i class="fas fa-exclamation-triangle me-2"></i>{{ flash_error }}
                </div>
            {% endfor %}
            
            <div class="card">
                <div class="card-header text-center">
                    <h3 class="m-0"><i class="fas fa-user-plus me-2"></i>Créer un compte</h3>
                </div>
                <div class="card-body p-4">
                    {{ form_errors(registrationForm) }}
                    
                    {{ form_start(registrationForm) }}
                    
                    <div class="user-type-selector mb-4">
                        <h5 class="mb-3">Fonction(s)</h5>
                        <p class="text-muted small">Veuillez sélectionner une ou plusieurs fonctions</p>
                        {{ form_widget(registrationForm.fonctions) }}
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(registrationForm.first_name) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(registrationForm.last_name) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(registrationForm.email) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(registrationForm.date_naissance) }}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_row(registrationForm.numero) }}
                        </div>
                        <div class="col-md-6 mb-3">
                            {{ form_row(registrationForm.matricule) }}
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        {{ form_row(registrationForm.addresse) }}
                    </div>
                    
                    <div class="mb-3">
                        {{ form_row(registrationForm.programme) }}
                    </div>
                    
                    <div class="mb-3">
                        {{ form_row(registrationForm.plainPassword) }}
                    </div>
                    
                    <div class="mb-4">
                        {{ form_row(registrationForm.agreeTerms) }}
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="fas fa-user-plus me-2"></i>S'inscrire
                        </button>
                    </div>
                    
                    <div class="text-center mt-3">
                        <a href="{{ path('app_login') }}" class="text-decoration-none">
                            <i class="fas fa-sign-in-alt me-1"></i>Déjà inscrit ? Connectez-vous
                        </a>
                    </div>
                    
                    {{ form_end(registrationForm) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Script pour mettre en évidence le type d'utilisateur sélectionné
    document.addEventListener('DOMContentLoaded', function() {
        const userTypeInputs = document.querySelectorAll('input[name="registration_form[userType]"]');
        
        userTypeInputs.forEach(input => {
            input.addEventListener('change', function() {
                // Mettre en évidence le type d'utilisateur sélectionné
                const parentLabel = this.closest('.form-check');
                document.querySelectorAll('.form-check').forEach(el => {
                    el.classList.remove('selected-type');
                });
                if (parentLabel) {
                    parentLabel.classList.add('selected-type');
                }
            });
        });
    });
</script>
{% endblock %}
