{% extends 'base.html.twig' %}

{% block title %}Unité d'Enseignement{% endblock %}

{% block body %}
    <h1 class="text-3xl font-bold mb-8 text-gray-800">Liste des Unités d'Enseignement</h1>

    <div class="overflow-x-auto shadow rounded-lg">
        <table class="min-w-full bg-white border border-gray-200">
            <thead class="bg-gray-100">
            <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">ID</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Nom</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Coefficient</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-700 uppercase tracking-wider">Actions</th>
            </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
            {% for unite_enseignement in unite_enseignements %}
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">{{ unite_enseignement.id }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ unite_enseignement.nom }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">{{ unite_enseignement.coefficient }}</td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex space-x-3">
                            <!-- Voir (œil) -->
                            <a href="{{ path('app_unite_enseignement_show', {'id': unite_enseignement.id}) }}"
                               class="text-blue-600 hover:text-blue-800 transition-colors duration-200"
                               title="Voir">
                                <i class="fas fa-eye"></i>
                            </a>

                            <!-- Modifier (crayon) -->
                            <a href="{{ path('app_unite_enseignement_edit', {'id': unite_enseignement.id}) }}"
                               class="text-yellow-500 hover:text-yellow-700 transition-colors duration-200"
                               title="Modifier">
                                <i class="fas fa-pencil-alt"></i>
                            </a>

                            <!-- Optionnel : Bouton Delete avec icône poubelle -->
                            <form method="post" action="{{ path('app_unite_enseignement_delete', {'id': unite_enseignement.id}) }}"
                                  onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce programme ?');"
                                  class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ unite_enseignement.id) }}">
                                <button type="submit"
                                        class="text-red-500 hover:text-red-700 transition-colors duration-200"
                                        title="Supprimer">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4" class="px-6 py-4 text-center text-gray-500">Aucun enregistrement trouvé</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="mt-6">
        <a href="{{ path('app_unite_enseignement_new') }}" class="inline-block bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700">
            Créer une nouvelle unité
        </a>
    </div>
{% endblock %}
